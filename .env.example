# Copy to .env and fill in the two keys. .env is git-ignored; on Render, set these in the dashboard.

# ---- Language and vision model (any OpenAI-compatible endpoint) ----
# Local Ollama alternative: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=gemma3:4b  LLM_API_KEY=ollama
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemma-4-26b-a4b-it
LLM_API_KEY=
LLM_TIMEOUT=240
# Free tiers are rate limited: calls per minute (0 = no limit) and max seconds to wait on a 429.
LLM_MAX_RPM=10
LLM_MAX_WAIT=45
# Gemma 4 on Google: minimal thinking answers in seconds instead of minutes. Empty = provider default.
LLM_THINKING_LEVEL=minimal
# Quota guards for a public demo: model calls per day, and quota-spending requests per visitor per 10 minutes.
LLM_MAX_PER_DAY=300
SUBMIT_LIMIT=8
# Optional: a code visitors must enter to start a walk or an import. Empty = open.
ACCESS_CODE=

# ---- ElevenLabs ----
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- Optional: Temporal Cloud instead of the local dev server ----
# TEMPORAL_ADDRESS=your-namespace.a1b2c.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=your-namespace.a1b2c
# TEMPORAL_API_KEY=
